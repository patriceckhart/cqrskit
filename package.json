{
  "name": "cqrskit",
  "version": "0.0.2",
  "description": "A lightweight TypeScript CQRS and Event Sourcing framework with pluggable database adapters",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/patriceckhart/cqrskit.git"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "test": "node --import tsx --test test/*.test.ts",
    "test:unit": "node --test test/*.test.cjs",
    "test:integration": "node --import tsx --test test/GenesisDBAdapter.test.ts",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "cqrs",
    "event-sourcing",
    "ddd",
    "domain-driven-design",
    "typescript",
    "genesisdb"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^20.11.19",
    "tsx": "^4.7.1",
    "typescript": "^5.3.3"
  },
  "dependencies": {
    "genesisdb": "^1.0.0",
    "zod": "^3.22.4"
  },
  "overrides": {
    "cloudevents": {
      "uuid": "^11.1.1"
    }
  },
  "peerDependencies": {
    "genesisdb": "^1.0.0"
  },
  "peerDependenciesMeta": {
    "genesisdb": {
      "optional": true
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "packageManager": "npm@10.9.4"
}
